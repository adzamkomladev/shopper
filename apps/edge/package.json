{
  "name": "@shopper/edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "vp build",
    "dev": "vp dev",
    "build:staging": "CLOUDFLARE_ENV=staging vp build",
    "deploy:staging": "wrangler deploy --config dist-staging/shopper_edge_dev/wrangler.json",
    "types": "wrangler types worker-configuration.d.ts --include-runtime=false"
  },
  "dependencies": {
    "@shopper/adapters-cf": "workspace:*",
    "@shopper/api": "workspace:*"
  }
}
