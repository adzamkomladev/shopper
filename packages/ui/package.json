{
  "name": "@shopper/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./hooks/shortcuts": {
      "types": "./src/hooks/shortcuts.tsx",
      "default": "./src/hooks/shortcuts.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "default": "./src/hooks/*.ts"
    },
    "./styles.css": "./src/styles/theme.css",
    "./components/input": {
      "types": "./src/components/input/control.tsx",
      "default": "./src/components/input/control.tsx"
    },
    "./components/input-group": {
      "types": "./src/components/input/group.tsx",
      "default": "./src/components/input/group.tsx"
    },
    "./components/table": {
      "types": "./src/components/table/primitive.tsx",
      "default": "./src/components/table/primitive.tsx"
    },
    "./components/data-table": {
      "types": "./src/components/table/data.tsx",
      "default": "./src/components/table/data.tsx"
    },
    "./components/app-backdrop": {
      "types": "./src/components/app/backdrop.tsx",
      "default": "./src/components/app/backdrop.tsx"
    },
    "./components/dropdown-menu": {
      "types": "./src/components/dropdown/menu.tsx",
      "default": "./src/components/dropdown/menu.tsx"
    },
    "./hooks/use-now": {
      "types": "./src/hooks/use/now.ts",
      "default": "./src/hooks/use/now.ts"
    },
    "./hooks/use-online": {
      "types": "./src/hooks/use/online.ts",
      "default": "./src/hooks/use/online.ts"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@shopper/config": "workspace:*",
    "@shopper/money": "workspace:*",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  }
}
