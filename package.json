{
  "name": "shopper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "typecheck": "tsrs -b",
    "services:up": "docker compose -f tooling/docker/compose.dev.yml up -d",
    "services:down": "docker compose -f tooling/docker/compose.dev.yml down",
    "services:clean": "tsx tooling/services/clean.ts",
    "db:migrate": "tsx tooling/database/cli.ts migrate",
    "db:seed": "tsx tooling/database/cli.ts seed",
    "db:reset": "tsx tooling/database/cli.ts reset",
    "guard": "tsx tooling/guard.ts",
    "e2e": "playwright test",
    "storage:setup": "tsx tooling/storage/setup.ts",
    "fonts:receipt": "tsx tooling/fonts/receipt.ts",
    "till:package": "tsx tooling/build/package.ts",
    "till:provision": "tsx tooling/till/provision.ts"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@fontsource/geist": "5.2.9",
    "@playwright/test": "1.64.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "aws4fetch": "1.0.20",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "uuid": "14.0.2",
    "vite-plus": "1.3.0",
    "wrangler": "4.151.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
