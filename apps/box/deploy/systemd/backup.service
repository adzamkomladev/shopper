# Installed as shopper-backup.service. One verified backup: dump, restore-and-count, age, rclone to R2.
# /etc/shopper/box.env holds DATABASE_URL, SHOPPER_BACKUP_RECIPIENT (age1…), SHOPPER_BACKUP_REMOTE (r2:<bucket>/<site>)
# and rclone's R2 remote as RCLONE_CONFIG_R2_TYPE=s3, _PROVIDER=Cloudflare, _ENDPOINT, _ACCESS_KEY_ID, _SECRET_ACCESS_KEY.
[Unit]
Description=Shopper verified backup to R2
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shopper
EnvironmentFile=/etc/shopper/box.env
Environment=SHOPPER_BACKUP_DIR=/var/lib/shopper/backups
# apps/box/src/cli/backup.ts; the sealed binary carries it from Day 38.
ExecStart=/opt/shopper/bin/shopper-backup
