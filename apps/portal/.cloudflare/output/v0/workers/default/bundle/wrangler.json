{
  "configPath": "/root/work/Shopper/apps/portal/wrangler.jsonc",
  "userConfigPath": "/root/work/Shopper/apps/portal/wrangler.jsonc",
  "topLevelName": "shopper-portal-dev",
  "definedEnvironments": ["staging"],
  "targetEnvironment": "staging",
  "account_id": "bd9ef997b398c9aeeee8ac3d3618efdc",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "jsx_factory": "React.createElement",
  "jsx_fragment": "React.Fragment",
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "name": "shopper-portal-staging",
  "main": "index.js",
  "routes": [{ "pattern": "shopper-staging.temtem.dev", "custom_domain": true }],
  "triggers": {},
  "assets": { "binding": "ASSETS", "run_worker_first": true, "directory": "../client" },
  "vars": { "SHOPPER_AUTH_URL": "https://shopper-staging.temtem.dev" },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_SEQUENCER",
        "class_name": "StoreSequencer",
        "script_name": "shopper-edge-staging"
      },
      { "name": "STORE_HUB", "class_name": "StoreHub", "script_name": "shopper-edge-staging" }
    ]
  },
  "workflows": [
    {
      "name": "shopper-price-change-staging",
      "binding": "PRICE_CHANGE",
      "class_name": "PriceChangeWorkflow",
      "script_name": "shopper-edge-staging"
    },
    {
      "name": "shopper-auth-flow-staging",
      "binding": "AUTH_FLOWS",
      "class_name": "AuthWorkflow",
      "script_name": "shopper-edge-staging"
    }
  ],
  "migrations": [],
  "exports": {},
  "kv_namespaces": [],
  "cloudchamber": {},
  "send_email": [],
  "queues": {
    "producers": [{ "binding": "NOTIFICATIONS", "queue": "shopper-notifications-staging" }]
  },
  "connect": [],
  "r2_buckets": [
    { "binding": "BLOBS", "bucket_name": "shopper-assets-staging" },
    { "binding": "IMPORTS", "bucket_name": "shopper-imports-staging" }
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "migrations_dir": "../../../../packages/db/sqlite/migrations",
      "database_name": "shopper-cache-staging",
      "database_id": "44230678-333c-446c-af51-22fe0c8eb20e"
    }
  ],
  "vectorize": [],
  "ai_search_namespaces": [],
  "ai_search": [],
  "agent_memory": [],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dfa4e3a17ca546ed8213ed257912db3f",
      "localConnectionString": "postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper"
    }
  ],
  "services": [],
  "analytics_engine_datasets": [],
  "dispatch_namespaces": [],
  "mtls_certificates": [],
  "pipelines": [],
  "k2": [],
  "secrets_store_secrets": [],
  "artifacts": [],
  "unsafe_hello_world": [],
  "flagship": [],
  "worker_loaders": [],
  "ratelimits": [],
  "vpc_services": [],
  "vpc_networks": [],
  "logfwdr": { "bindings": [] },
  "observability": { "enabled": true },
  "python_modules": { "exclude": ["**/*.pyc"] },
  "dev": {
    "ip": "localhost",
    "local_protocol": "http",
    "upstream_protocol": "http",
    "enable_containers": true,
    "generate_types": false
  },
  "no_bundle": true
}
