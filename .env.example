PAYSTACK_SECRET_KEY=
# Low-stock SMS on the box: the key enables it; sender is the registered Arkesel sender ID.
ARKESEL_API_KEY=
ARKESEL_SENDER=Shopper
ARKESEL_BASE_URL=
DATABASE_URL=postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper
# Box object storage (RustFS): imports and till receipt PDFs share the endpoint and credentials.
SHOPPER_S3_ENDPOINT=
SHOPPER_S3_BUCKET=shopper-imports-dev
SHOPPER_S3_RECEIPTS_BUCKET=shopper-receipts-dev
SHOPPER_S3_ACCESS_KEY_ID=
SHOPPER_S3_SECRET_ACCESS_KEY=
SHOPPER_S3_REGION=us-east-1
# MoMo through Hubtel for orgs that choose it in Settings → Payments; all three enable it.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
