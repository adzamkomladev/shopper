{
  "name": "@shopper/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./management": {
      "types": "./src/management.ts",
      "default": "./src/management.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./orgs": {
      "types": "./src/orgs.ts",
      "default": "./src/orgs.ts"
    },
    "./catalogue": {
      "types": "./src/catalogue/index.ts",
      "default": "./src/catalogue/index.ts"
    },
    "./changes": {
      "types": "./src/changes/index.ts",
      "default": "./src/changes/index.ts"
    },
    "./till": {
      "types": "./src/till/index.ts",
      "default": "./src/till/index.ts"
    },
    "./payments/paystack": {
      "types": "./src/payments/paystack/index.ts",
      "default": "./src/payments/paystack/index.ts"
    },
    "./stock": {
      "types": "./src/stock/index.ts",
      "default": "./src/stock/index.ts"
    },
    "./sales": {
      "types": "./src/sales/index.ts",
      "default": "./src/sales/index.ts"
    },
    "./receipts": {
      "types": "./src/receipts/index.ts",
      "default": "./src/receipts/index.ts"
    },
    "./payments": {
      "types": "./src/payments/index.ts",
      "default": "./src/payments/index.ts"
    },
    "./till/settlement": {
      "types": "./src/till/tenders/settle.ts",
      "default": "./src/till/tenders/settle.ts"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@shopper/assets": "workspace:*",
    "@shopper/audit": "workspace:*",
    "@shopper/db-pg": "workspace:*",
    "@shopper/db-sqlite": "workspace:*",
    "@shopper/money": "workspace:*",
    "@shopper/ports": "workspace:*",
    "@shopper/tax": "workspace:*",
    "@shopper/utils": "workspace:*",
    "drizzle-orm": "0.45.3",
    "uuid": "14.0.2",
    "valibot": "1.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
