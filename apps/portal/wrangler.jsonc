{
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd6330074f7e4d0abbc989ad2028e72c",
      "localConnectionString": "postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper",
    },
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "migrations_dir": "../../packages/db/sqlite/migrations",
      "database_name": "shopper-cache-dev",
      "database_id": "2485dba5-588e-49e3-8bf5-bd2cd5fbce16",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "shopper-assets-dev",
    },
    {
      "binding": "IMPORTS",
      "bucket_name": "shopper-imports-dev",
      "remote": true,
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS",
        "queue": "shopper-notifications-dev",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_SEQUENCER",
        "class_name": "StoreSequencer",
        "script_name": "shopper-edge-dev",
      },
      {
        "name": "STORE_HUB",
        "class_name": "StoreHub",
        "script_name": "shopper-edge-dev",
      },
    ],
  },
  "workflows": [
    {
      "name": "shopper-price-change-dev",
      "binding": "PRICE_CHANGE",
      "class_name": "PriceChangeWorkflow",
      "script_name": "shopper-edge-dev",
    },
    {
      "name": "shopper-auth-flow-dev",
      "binding": "AUTH_FLOWS",
      "class_name": "AuthWorkflow",
      "script_name": "shopper-edge-dev",
    },
    {
      "name": "shopper-momo-payment-dev",
      "binding": "MOMO_PAYMENT",
      "class_name": "MomoPaymentWorkflow",
      "script_name": "shopper-edge-dev",
    },
  ],
  "name": "shopper-portal-dev",
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "bd9ef997b398c9aeeee8ac3d3618efdc",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_serverFn/*"],
  },
  "vars": {
    "SHOPPER_AUTH_URL": "http://localhost:5173",
    "SHOPPER_ENVIRONMENT": "dev",
  },
  "env": {
    "staging": {
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "dfa4e3a17ca546ed8213ed257912db3f",
          "localConnectionString": "postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper",
        },
      ],
      "d1_databases": [
        {
          "binding": "CACHE_DB",
          "migrations_dir": "../../packages/db/sqlite/migrations",
          "database_name": "shopper-cache-staging",
          "database_id": "44230678-333c-446c-af51-22fe0c8eb20e",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BLOBS",
          "bucket_name": "shopper-assets-staging",
        },
        {
          "binding": "IMPORTS",
          "bucket_name": "shopper-imports-staging",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS",
            "queue": "shopper-notifications-staging",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORE_SEQUENCER",
            "class_name": "StoreSequencer",
            "script_name": "shopper-edge-staging",
          },
          {
            "name": "STORE_HUB",
            "class_name": "StoreHub",
            "script_name": "shopper-edge-staging",
          },
        ],
      },
      "workflows": [
        {
          "name": "shopper-price-change-staging",
          "binding": "PRICE_CHANGE",
          "class_name": "PriceChangeWorkflow",
          "script_name": "shopper-edge-staging",
        },
        {
          "name": "shopper-auth-flow-staging",
          "binding": "AUTH_FLOWS",
          "class_name": "AuthWorkflow",
          "script_name": "shopper-edge-staging",
        },
        {
          "name": "shopper-momo-payment-staging",
          "binding": "MOMO_PAYMENT",
          "class_name": "MomoPaymentWorkflow",
          "script_name": "shopper-edge-staging",
        },
      ],
      "name": "shopper-portal-staging",
      "routes": [
        {
          "pattern": "shopper-staging.temtem.dev",
          "custom_domain": true,
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/_serverFn/*"],
      },
      "vars": {
        "SHOPPER_AUTH_URL": "https://shopper-staging.temtem.dev",
        "SHOPPER_ENVIRONMENT": "staging",
      },
    },
  },
}
