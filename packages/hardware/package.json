{
  "name": "@shopper/hardware",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./network": {
      "types": "./src/network.ts",
      "default": "./src/network.ts"
    },
    "./serial": {
      "types": "./src/serial/index.ts",
      "default": "./src/serial/index.ts"
    },
    "./spooler": {
      "types": "./src/spooler.ts",
      "default": "./src/spooler.ts"
    },
    "./receipt": {
      "types": "./src/receipt/view.tsx",
      "default": "./src/receipt/view.tsx"
    },
    "./statement": {
      "types": "./src/statement/view.tsx",
      "default": "./src/statement/view.tsx"
    },
    "./render": {
      "types": "./src/render/index.ts",
      "default": "./src/render/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@shopper/core": "workspace:*",
    "@shopper/money": "workspace:*",
    "@shopper/utils": "workspace:*",
    "pdf-lib": "1.17.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serialport": "13.0.0",
    "valibot": "1.1.0"
  }
}
