#!/bin/sh
# Runs as root when the box asks for an update (shopper-update.path sees apply.json). The box has already verified the bundle,
# made a verified backup and unpacked it into the spare slot; this only switches slots, and switches back if the new box
# does not become healthy. Migrations are forward-only: after a rollback that followed a migration, restore the pre-update backup.
set -u
root=${SHOPPER_ROOT:-/opt/shopper}
updates=${SHOPPER_UPDATES_DIR:-/var/lib/shopper/updates}
systemctl=${SHOPPER_SYSTEMCTL:-systemctl}
health=${SHOPPER_HEALTH_URL:-http://127.0.0.1:3001/api/health}
seconds=${SHOPPER_HEALTH_SECONDS:-90}
request="$updates/apply.json"
now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
field() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p" "$request"; }
finish() { # status message
  printf '{"status":"%s","version":"%s","at":"%s","message":"%s"}\n' "$1" "$version" "$(now)" "$2" > "$updates/result.json.tmp"
  mv "$updates/result.json.tmp" "$updates/result.json"
  rm -f "$request"
}
healthy() { i=0; while [ "$i" -lt "$seconds" ]; do curl -fsS --max-time 2 "$health" >/dev/null 2>&1 && return 0; i=$((i + 1)); sleep 1; done; return 1; }
switch() { ln -sfn "$root/slots/$1" "$root/current.next" && mv -T "$root/current.next" "$root/current"; }

[ -f "$request" ] || exit 0
new=$(field slot); version=$(field version)
old=$(basename "$(readlink -f "$root/current")")
case "$new" in a|b) ;; *) finish failed "The update named no slot"; exit 1 ;; esac
[ "$new" != "$old" ] && [ -x "$root/slots/$new/shopper-box" ] || { finish failed "Slot $new is not ready"; exit 1; }

"$systemctl" stop shopper-box
switch "$new"
"$systemctl" start shopper-box
if healthy; then
  # The slot we left becomes the spare the next update unpacks into, as the box's own user.
  chown -R "${SHOPPER_USER:-shopper}:${SHOPPER_USER:-shopper}" "$root/slots/$old" 2>/dev/null || true
  finish applied "Now running $version from slot $new"; exit 0
fi
"$systemctl" stop shopper-box
switch "$old"
"$systemctl" start shopper-box
finish rolled_back "$version did not start; the box is back on slot $old. If the database changed, restore the backup taken before the update"
exit 1
