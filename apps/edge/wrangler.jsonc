{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shopper-edge-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
    },
  },
  "env": {
    "staging": {
      "name": "shopper-edge-staging",
      "workers_dev": true,
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "dfa4e3a17ca546ed8213ed257912db3f",
          "localConnectionString": "postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper",
        },
      ],
      "browser": { "binding": "BROWSER" },
      "d1_databases": [
        {
          "binding": "CACHE_DB",
          "migrations_dir": "../../packages/db/sqlite/migrations",
          "database_name": "shopper-cache-staging",
          "database_id": "44230678-333c-446c-af51-22fe0c8eb20e",
        },
      ],
      "r2_buckets": [
        {
          "binding": "BLOBS",
          "bucket_name": "shopper-assets-staging",
        },
        { "binding": "IMPORTS", "bucket_name": "shopper-imports-staging" },
        { "binding": "RECEIPTS", "bucket_name": "shopper-receipts-staging" },
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFICATIONS",
            "queue": "shopper-notifications-staging",
          },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "STORE_SEQUENCER",
            "class_name": "StoreSequencer",
          },
          {
            "name": "STORE_HUB",
            "class_name": "StoreHub",
          },
        ],
      },
      "workflows": [
        {
          "name": "shopper-price-change-staging",
          "binding": "PRICE_CHANGE",
          "class_name": "PriceChangeWorkflow",
        },
        {
          "name": "shopper-auth-flow-staging",
          "binding": "AUTH_FLOWS",
          "class_name": "AuthWorkflow",
        },
        {
          "name": "shopper-momo-payment-staging",
          "binding": "MOMO_PAYMENT",
          "class_name": "MomoPaymentWorkflow",
        },
      ],
      "routes": [
        {
          "pattern": "shopper-api-staging.temtem.dev",
          "custom_domain": true,
        },
      ],
    },
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "dd6330074f7e4d0abbc989ad2028e72c",
      "localConnectionString": "postgresql://shopper:shopper_dev_only@127.0.0.1:5432/shopper",
    },
  ],
  "browser": { "binding": "BROWSER" },
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "migrations_dir": "../../packages/db/sqlite/migrations",
      "database_name": "shopper-cache-dev",
      "database_id": "2485dba5-588e-49e3-8bf5-bd2cd5fbce16",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "shopper-assets-dev",
    },
    { "binding": "IMPORTS", "bucket_name": "shopper-imports-dev", "remote": true },
    { "binding": "RECEIPTS", "bucket_name": "shopper-receipts-dev", "remote": true },
  ],
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATIONS",
        "queue": "shopper-notifications-dev",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE_SEQUENCER",
        "class_name": "StoreSequencer",
      },
      {
        "name": "STORE_HUB",
        "class_name": "StoreHub",
      },
    ],
  },
  "workflows": [
    {
      "name": "shopper-price-change-dev",
      "binding": "PRICE_CHANGE",
      "class_name": "PriceChangeWorkflow",
    },
    { "name": "shopper-auth-flow-dev", "binding": "AUTH_FLOWS", "class_name": "AuthWorkflow" },
    {
      "name": "shopper-momo-payment-dev",
      "binding": "MOMO_PAYMENT",
      "class_name": "MomoPaymentWorkflow",
    },
  ],
  "account_id": "bd9ef997b398c9aeeee8ac3d3618efdc",
  // Declarative exports, not `migrations`: the staging Worker was first deployed with `exports`
  // and Cloudflare refuses to switch a Worker back to migrations (code 100403).
  "exports": {
    "StoreSequencer": { "type": "durable-object", "storage": "sqlite" },
    "StoreHub": { "type": "durable-object", "storage": "sqlite" },
  },
}
