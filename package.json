{
  "name": "shopper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "typecheck": "tsc -b",
    "services:up": "docker compose -f tooling/docker-compose.dev.yml up -d",
    "services:down": "docker compose -f tooling/docker-compose.dev.yml down",
    "db:migrate": "tsx tooling/database.ts migrate",
    "db:seed": "tsx tooling/database.ts seed",
    "guard": "tsx tooling/guard.ts"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "uuid": "14.0.2",
    "vite-plus": "1.0.0",
    "wrangler": "4.147.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.11.0 <25"
  }
}
